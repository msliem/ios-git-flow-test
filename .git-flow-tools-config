# Git Flow Tools Configuration
# Copy this file to your project root as .git-flow-tools-config for project-specific settings
# Or copy to ~/.git-flow-tools-config for global settings (installed automatically)

# =============================================================================
# REQUIRED CONFIGURATION - These MUST be set for Git Flow Tools to work
# =============================================================================

# Main branch names
PRODUCTION_BRANCH="production"
STAGING_BRANCH="staging"
DEVELOP_BRANCH="develop"

# Tag prefixes for different environments
STAGING_TAG_PREFIX="staging/"
PRODUCTION_TAG_PREFIX="production/"

# Default remote repository
REMOTE="origin"

# =============================================================================
# MULTI-PLATFORM CONFIGURATION
# =============================================================================

# Enable platform-specific tags (true/false)
# When true: versions include platform prefix (android-1.2.3-rc-01)
# When false: legacy single-environment mode (1.2.3-rc-01)
PLATFORM_SPECIFIC_TAGS=true

# List of ALL supported platforms (required when PLATFORM_SPECIFIC_TAGS=true)
# Format: space-separated list of platform names
# Example: PLATFORMS="android ios web"
PLATFORMS=""

# Classification of platforms for intelligent propagation
# Required when PLATFORM_SPECIFIC_TAGS=true

# COMMON platforms: Shared code that other platforms depend on
# Example: shared modules, core libraries, common code
# Changes to common platforms propagate to all dependent platforms
# Format: space-separated list
# Example: COMMON_PLATFORMS="shared core"
COMMON_PLATFORMS=""

# INDEPENDENT platforms: Platform-specific code
# Example: android, ios, web, desktop
# Changes stay within the same platform (no cross-platform propagation)
# Format: space-separated list
# Example: INDEPENDENT_PLATFORMS="android ios web"
INDEPENDENT_PLATFORMS="android ios shared"

# =============================================================================
# BRANCH PREFIX CONFIGURATION (Required for internal operations)
# =============================================================================

# Release branch prefixes
RELEASE_STAGING_PREFIX="release/stg/"
RELEASE_PRODUCTION_PREFIX="release/prod/"

# Hotfix branch prefixes
HOTFIX_STAGING_PREFIX="hotfix/stg/"
HOTFIX_PRODUCTION_PREFIX="hotfix/prod/"

# =============================================================================
# WORKFLOW BEHAVIOR CONFIGURATION
# =============================================================================

# Auto-sync branches after operations (true/false)
# When true, automatically syncs branches after releases/hotfixes
AUTO_SYNC=true

# Require confirmation for destructive operations (true/false)
# When true, asks for confirmation before pushing, merging, etc.
REQUIRE_CONFIRMATION=true

# Non-interactive mode (true/false)
# When true, automatically confirms all prompts (useful for CI/CD)
GIT_FLOW_NON_INTERACTIVE=false

# Conflict resolution strategy
# Options: "interactive" (asks for help), "abort" (stops on conflict), "skip" (continues)
CONFLICT_STRATEGY="interactive"

# =============================================================================
# VERSION VALIDATION CONFIGURATION
# =============================================================================

# Enforce semantic versioning (true/false)
# When true, requires versions to follow MAJOR.MINOR.PATCH format
# When PLATFORM_SPECIFIC_TAGS=true: platform-MAJOR.MINOR.PATCH format
ENFORCE_SEMVER=true

# Allow hotfixes on older versions (true/false)
# When true, allows creating hotfixes for versions other than the latest
ALLOW_OLDER_HOTFIXES=true

# =============================================================================
# SECURITY AND SAFETY CONFIGURATION
# =============================================================================

# Allow force push in emergencies (true/false)
# WARNING: Only enable if you understand the risks
ALLOW_FORCE_PUSH=false

# Require clean working tree for operations (true/false)
REQUIRE_CLEAN_WORKING_TREE=true

# Validate remote connectivity before operations (true/false)
VALIDATE_REMOTE_CONNECTIVITY=true

# =============================================================================
# CONFIGURATION VALIDATION SETTINGS
# =============================================================================

# Configuration validation behavior
# "strict" - error if any required config is missing (recommended)
# "lenient" - use defaults for missing values, warn only
CONFIG_VALIDATION_MODE="strict"

# =============================================================================
# DEBUGGING AND LOGGING CONFIGURATION
# =============================================================================

# Debug mode (true/false)
# When true, shows additional debug information
DEBUG=false

# Remote tag cache duration in seconds (default: 5 minutes)
REMOTE_TAG_CACHE_DURATION=300

# =============================================================================
# CONFIGURATION SOURCE INFORMATION
# =============================================================================

# Configuration Load Order:
# 1. Project: ./git-flow-tools-config (highest priority)
# 2. Project: ./.git-flow-tools-config
# 3. Global: ~/.git-flow-tools-config (lowest priority)
# 4. NO DEFAULTS - Configuration is REQUIRED

# =============================================================================
# EXAMPLE CUSTOM CONFIGURATIONS
# =============================================================================

# Example 1: Different branch names (GitHub flow style)
# PRODUCTION_BRANCH="main"
# STAGING_BRANCH="preprod"
# DEVELOP_BRANCH="dev"

# Example 2: Custom tag formats
# STAGING_TAG_PREFIX="test/v"
# PRODUCTION_TAG_PREFIX="prod/v"

# Example 3: Multiple remotes
# REMOTE="upstream"

# Example 4: Disable auto-sync for manual control
# AUTO_SYNC=false

# Example 5: Custom branch prefixes
# RELEASE_STAGING_PREFIX="release/test/"
# RELEASE_PRODUCTION_PREFIX="release/prod/"
# HOTFIX_STAGING_PREFIX="hotfix/test/"
# HOTFIX_PRODUCTION_PREFIX="hotfix/prod/"

# Example 6: Multi-platform configuration (KMP project)
# PLATFORM_SPECIFIC_TAGS=true
# PLATFORMS="shared android ios"
# COMMON_PLATFORMS="shared"
# INDEPENDENT_PLATFORMS="android ios"
# # Version format: shared-1.2.3-rc-01, android-2.0.1-rc-02, ios-2.0.1-rc-02

# Example 7: CI/CD configuration
# GIT_FLOW_NON_INTERACTIVE=true
# AUTO_SYNC=true
# DEBUG=true

# Example 8: Strict security settings
# ALLOW_FORCE_PUSH=false
# REQUIRE_CLEAN_WORKING_TREE=true
# VALIDATE_REMOTE_CONNECTIVITY=true

# Example 9: Multi-platform with custom platforms
# PLATFORM_SPECIFIC_TAGS=true
# PLATFORMS="core mobile web desktop server"
# COMMON_PLATFORMS="core"
# INDEPENDENT_PLATFORMS="mobile web desktop server"
# # Version format: core-1-0-0-rc-01, mobile-1-0-0-rc-01, etc.

# Example 10: Legacy single-environment mode (default)
# PLATFORM_SPECIFIC_TAGS=false
# PLATFORMS=""
# COMMON_PLATFORMS=""
# INDEPENDENT_PLATFORMS=""
# # Version format: 1.2.3-rc-01